  // 自动签到（Discuz! X3.4 每日签到插件，每日首次自动签到） function autoSign(force) {
   try {
    const cfg = getSettings();
    if (!cfg.autoSign && !force) return;
    const now = new Date();
    const dateKey = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
    if (!force && GM_getValue('bjx_lastSign', '') === dateKey) return;
    // 今日已签到 const base = location.origin + '/';
    const signPath = (cfg.signUrl || 'plugin.php?id=fx_checkin:list').trim();
    const url = /^https?:\/\//i.test(signPath) ? signPath : base + signPath.replace(/^\//, '');
    GM_xmlhttpRequest({
     method: 'GET', url: url, headers: {
      'User-Agent': navigator.userAgent, 'Referer': location.href, 'Accept': 'text/html' 
    }
    , onload: (res) => {
      try {
       const html = res.responseText || '';
       if (res.status !== 200) return;
       // 已签到（避免重复提交） if (/已签到|今日已签到|今天已经签到|您今天已经签到|您今日已签到|已经签到|连续签到/i.test(html)) {
        GM_setValue('bjx_lastSign', dateKey);
        return;
      }
       // 提取签到表单及其字段（适配多数 Discuz 签到插件） const formMatch = html.match(/<form\b[^>]*>([\s\S]*?)<\/form>/i);
       if (!formMatch) {
        GM_setValue('bjx_lastSign', dateKey);
        return;
      }
       const formHtml = formMatch[0];
       const actionMatch = formHtml.match(/action="([^"]*)"/i);
       let action = actionMatch ? actionMatch[1] : url;
       if (action) {
        if (/^https?:\/\//i.test(action)) {
        /* 绝对地址 */
       }
        else if (action.charAt(0) === '/') action = location.origin + action;
        else action = url.split('?')[0].replace(/[^\/]*$/, '') + action;
      }
       else action = url;
       const fields = {
      }
      ;
       const inputRe = /<input\b[^>]*>/gi;
       let im;
       while ((im = inputRe.exec(formHtml)) !== null) {
        const tag = im[0];
        const n = (tag.match(/name="([^"]*)"/i) || [])[1];
        if (!n) continue;
        const v = (tag.match(/value="([^"]*)"/i) || [])[1] || '';
        fields[n] = v;
      }
       if (!fields.formhash) {
        GM_setValue('bjx_lastSign', dateKey);
        return;
      }
       // 常见心情/模式字段默认值（DSU 等插件） if (fields.qdxq === undefined || fields.qdxq === '') fields.qdxq = 'qq';
       if (fields.qdmode === undefined || fields.qdmode === '') fields.qdmode = '1';
       if (fields.todaysay === undefined) fields.todaysay = '';
       let data = '';
       for (const k in fields) {
        if (k === 'submit' || k === 'qr') continue;
        data += (data ? '&' : '') + encodeURIComponent(k) + '=' + encodeURIComponent(fields[k] || '');
      }
       GM_xmlhttpRequest({
        method: 'POST', url: action, headers: {
         'Content-Type': 'application/x-www-form-urlencoded', 'Referer': url, 'User-Agent': navigator.userAgent, 'X-Requested-With': 'XMLHttpRequest' 
       }
       , data: data, onload: (r2) => {
         GM_setValue('bjx_lastSign', dateKey);
         if (force) showSignToast(/签到成功|恭喜|成功签到|已连续签到|签到完成|success/i.test(r2.responseText || '') ? '✅ 签到成功' : '⚠️ 已提交签到请求');
       }
       , onerror: () => {
         if (force) showSignToast('❌ 签到请求失败');
       }
      }
      );
     }
      catch (e) {
       GM_setValue('bjx_lastSign', dateKey);
     }
    }
    , onerror: () => {
      if (force) showSignToast('❌ 无法访问签到页面');
    }
   }
   );
  }
   catch (e) {
  }
 }
