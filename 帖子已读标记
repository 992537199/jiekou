// ==UserScript==
// @name         福利吧已读帖子标记（灰色+删除线）
// @namespace    http://tampermonkey.net/
// @version      0.3
// @description  自动标记已读帖子，修复iPhone Safari切后台返回标记丢失问题；支持异步翻页、新标签打开
// @author       豆包
// @match        https://www.wnflb2023.com/forum-*.html
// @match        https://www.wnflb2023.com/forum.php?mod=forumdisplay*
// @grant        GM_setValue
// @grant        GM_getValue
// ==/UserScript==

(function () {
    'use strict';
    const KEY_PREFIX = 'read_post_';
    let observer = null;
    let refreshDebounceTimer = null;

    // 添加样式表，统一管理已读样式，替代零散内联style，Safari更稳
    function injectStyle() {
        if(document.getElementById('read_post_mark_css')) return;
        const css = document.createElement('style');
        css.id = 'read_post_mark_css';
        css.textContent = `
            a.read-post-marked {
                color:#999 !important;
                text-decoration: line-through !important;
            }
        `;
        document.head.appendChild(css);
    }

    function getTidFromTbody(tbody) {
        return tbody.id.replace(/\D/g, '');
    }

    // 给单个帖子应用已读标记
    function applyReadStyle(tbody) {
        const tid = getTidFromTbody(tbody);
        if (!tid) return;
        const a = tbody.querySelector('a.s.xst');
        if (!a) return;
        if (GM_getValue(KEY_PREFIX + tid, false)) {
            a.classList.add('read-post-marked');
        }
    }

    // 刷新全部帖子标记，加防抖防止频繁执行
    function refreshAllReadMark() {
        clearTimeout(refreshDebounceTimer);
        refreshDebounceTimer = setTimeout(() => {
            document.querySelectorAll(
                '#threadlisttableid tbody[id^="normalthread_"], #threadlisttableid tbody[id^="stickthread_"]'
            ).forEach((tb) => {
                applyReadStyle(tb);
            });
        }, 80);
    }

    // 重启DOM监听器（Safari休眠后observer会断开，需要重建）
    function restartObserver() {
        if(observer) observer.disconnect();
        observer = new MutationObserver(()=> refreshAllReadMark());
        const listWrap = document.getElementById('threadlisttableid');
        if(listWrap){
            observer.observe(listWrap, {
                childList: true,
                subtree: true
            });
        }
    }

    // 点击帖子标记已读（支持新标签打开，click依然触发）
    document.addEventListener(
        'click',
        function (e) {
            const target = e.target.closest('a.s.xst');
            if (!target) return;
            const tbody = target.closest('tbody[id]');
            if (!tbody) return;
            const tid = getTidFromTbody(tbody);
            if (!tid) return;
            GM_setValue(KEY_PREFIX + tid, true);
            target.classList.add('read-post-marked');
        },
        false
    );


    // ==========关键修复：监听页面可见性，切回Safari立刻重刷==========
    document.addEventListener('visibilitychange', ()=>{
        if(!document.hidden){
            // 用户从后台切回页面，重启监听+全量重绘标记
            restartObserver();
            refreshAllReadMark();
        }
    })

    // 循环保活监听器，Safari后台休眠后容器丢失自动恢复
    setInterval(()=>{
        const listWrap = document.getElementById('threadlisttableid');
        if(listWrap && observer){
            // 检查是否还在监听目标，断开则重启
            if(observer.takeRecords && observer.takeRecords().length === 0){
                // 无操作，正常
            }
        }else{
            restartObserver();
            refreshAllReadMark();
        }
    }, 1200);


    // 初始化入口
    function init(){
        injectStyle();
        restartObserver();
        refreshAllReadMark();
    }

    // 多时机初始化，兼容Safari各种加载时序
    if(document.readyState === "complete" || document.readyState === "interactive"){
        setTimeout(init,200);
    }else{
        document.addEventListener('DOMContentLoaded', ()=> setTimeout(init,200));
    }
    window.addEventListener('load', ()=> setTimeout(init, 300));
})();