// ==UserScript==
// @name         福利吧已读帖子标记（灰色+删除线｜Safari后台休眠修复版）
// @namespace    http://tampermonkey.net/
// @version      0.4
// @description  彻底修复iPhone Safari长时间切后台标记消失问题；pageshow页面恢复事件优先，异步翻页、新标签打开支持
// @author       豆包
// @match        https://www.wnflb2023.com/forum-*.html
// @match        https://www.wnflb2023.com/forum.php?mod=forumdisplay*
// @grant        GM_setValue
// @grant        GM_getValue
// ==/UserScript==

(function () {
    'use strict';
    const KEY_PREFIX = 'read_post_';
    let observer = null;
    let refreshDebounceTimer = null;

    function injectStyle() {
        if(document.getElementById('read_post_mark_css')) return;
        const css = document.createElement('style');
        css.id = 'read_post_mark_css';
        css.textContent = `
            a.read-post-marked {
                color:#999 !important;
                text-decoration: line-through !important;
            }
        `;
        document.head.appendChild(css);
    }

    function getTidFromTbody(tbody) {
        return tbody.id.replace(/\D/g, '');
    }

    function applyReadStyle(tbody) {
        const tid = getTidFromTbody(tbody);
        if (!tid) return;
        const a = tbody.querySelector('a.s.xst');
        if (!a) return;
        if (GM_getValue(KEY_PREFIX + tid, false)) {
            a.classList.add('read-post-marked');
        }
    }

    function refreshAllReadMark() {
        clearTimeout(refreshDebounceTimer);
        refreshDebounceTimer = setTimeout(() => {
            document.querySelectorAll(
                '#threadlisttableid tbody[id^="normalthread_"], #threadlisttableid tbody[id^="stickthread_"]'
            ).forEach((tb) => {
                applyReadStyle(tb);
            });
        }, 60);
    }

    function destroyObserver(){
        if(observer){
            observer.disconnect();
            observer = null;
        }
    }

    function restartObserver() {
        destroyObserver();
        const listWrap = document.getElementById('threadlisttableid');
        if(!listWrap) return;
        observer = new MutationObserver(()=> refreshAllReadMark());
        observer.observe(listWrap, {
            childList: true,
            subtree: true
        });
    }

    function fullInit(){
        injectStyle();
        restartObserver();
        refreshAllReadMark();
    }

    // 点击帖子标记已读
    document.addEventListener(
        'click',
        function (e) {
            const target = e.target.closest('a.s.xst');
            if (!target) return;
            const tbody = target.closest('tbody[id]');
            if (!tbody) return;
            const tid = getTidFromTbody(tbody);
            if (!tid) return;
            GM_setValue(KEY_PREFIX + tid, true);
            target.classList.add('read-post-marked');
        },
        false
    );

    // ==========核心修复：pageshow 是iOS Safari页面从后台缓存恢复最可靠事件==========
    window.addEventListener('pageshow', ()=>{
        // 页面从后台恢复，直接完整重建全部功能、重绘标记
        fullInit();
    })

    document.addEventListener('visibilitychange', ()=>{
        if(!document.hidden){
            fullInit();
        }
    })

    // 初始化入口
    if(document.readyState === "complete" || document.readyState === "interactive"){
        setTimeout(fullInit,150);
    }else{
        document.addEventListener('DOMContentLoaded', ()=> setTimeout(fullInit,150));
    }
    window.addEventListener('load', ()=> setTimeout(fullInit, 250));

})();