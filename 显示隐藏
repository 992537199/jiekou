// ==UserScript==
// @name         福利吧白色隐藏文字完整揭示
// @namespace    http://tampermonkey.net/
// @version      1.1
// @description  修复白色font包裹链接无法显示问题，自动识别#ffffff白色隐藏文字、同色隐藏、极小字号、空白隐藏链接
// @author       You
// @match        https://www.wnflb2023.com/forum.php*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    const isEnabled = true;
    const isWnflb = true;
    const seenHashes = new Set();
    const foundItems = [];
    const revealedItems = [];

    // 灰度计算
    function getGrayLevel(r, g, b) {
        return r * 0.299 + g * 0.587 + b * 0.114;
    }

    // 判断浅色/白色
    function isLightColor(colorStr) {
        if (!colorStr) return false;
        const pureWhiteList = ['white', '#fff', '#ffffff', 'rgb(255,255,255)', 'rgba(255,255,255,1)'];
        if (pureWhiteList.includes(colorStr.toLowerCase())) return true;

        try {
            const rgbaMatch = colorStr.match(/rgba\((\d+),\s*(\d+),\s*(\d+),\s*([.\d]+)\)/i);
            if (rgbaMatch) {
                const [, r, g, b, a] = rgbaMatch;
                const alpha = parseFloat(a);
                // 透明直接判定为隐藏
                if (alpha <= 0.2) return true;
                return getGrayLevel(+r, +g, +b) > 192;
            }
            const rgbMatch = colorStr.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);
            if (rgbMatch) {
                const [, r, g, b] = rgbMatch;
                return getGrayLevel(+r, +g, +b) > 192;
            }
            // 六位十六进制 #ffffff
            const h6 = colorStr.match(/^#([a-fA-F0-9]{6})$/);
            if (h6) {
                const r = parseInt(h6[1].slice(0,2),16);
                const g = parseInt(h6[1].slice(2,4),16);
                const b = parseInt(h6[1].slice(4,6),16);
                return getGrayLevel(r,g,b) > 192;
            }
            // 三位简写 #fff
            const h3 = colorStr.match(/^#([a-fA-F0-9]{3})$/);
            if (h3) {
                const r = parseInt(h3[1][0]+h3[1][0],16);
                const g = parseInt(h3[1][1]+h3[1][1],16);
                const b = parseInt(h3[1][2]+h3[1][2],16);
                return getGrayLevel(r,g,b) > 192;
            }
        } catch (e) {}
        return false;
    }

    // 判断标签是否设置了颜色/字号属性
    function fontHasExplicitColor(el) {
        if (el.getAttribute('color')) return true;
        if (el.getAttribute('size')) return true;
        const s = el.style;
        return !!(s && (s.color || s.backgroundColor || s.background || s.fontSize));
    }

    // 提取磁力hash
    function extractBtih(magnetStr) {
        if (!magnetStr) return null;
        const match = magnetStr.match(/urn:btih:([0-9a-fA-F]{32,40})/);
        return match ? match[1].toLowerCase() : null;
    }

    function saveHistory(link, hash, type) {}

    // 解析链接/磁力
    function createRevealedItem(text, element) {
        try {
            if (/^magnet:\?/i.test(text)) {
                return {encoded:text, magnet:text, element, type:'magnet'};
            }
            const hashMatch = text.match(/^([a-fA-F0-9]{32,40})$/);
            if (hashMatch) {
                const btih = hashMatch[1].toLowerCase();
                if (seenHashes.has(btih)) return null;
                seenHashes.add(btih);
                return {encoded:text, magnet:`magnet:?xt=urn:btih:${btih}`, element, type:'magnet'};
            }
            if (/^https?:\/\//i.test(text)) {
                return {encoded:text, magnet:text, element, type:'url'};
            }
            if (/^[a-zA-Z0-9][-a-zA-Z0-9]*\.[a-zA-Z]{2,}(\/|$)/.test(text)) {
                return {encoded:text, magnet:`https://${text}`, element, type:'url'};
            }
        } catch (e) {}
        return null;
    }

    // 高亮样式
    function styleSecret(el) {
        el.style.background = '#d92121';
        el.style.color = '#ffffff';
        el.style.padding = '2px 6px';
        el.style.borderRadius = '4px';
        el.style.fontWeight = 'bold';
        el.style.display = 'inline';
        el.style.margin = '2px 0';
        el.style.lineHeight = '1.8';
    }

    function scanHiddenContent() {
        if (!isEnabled || !document.body || !isWnflb) return 0;
        const postAreas = document.querySelectorAll('td.t_f, .message');
        let addedCount = 0;

        postAreas.forEach(area => {
            try {
                const textEls = area.querySelectorAll('font, span, b, i, strong, em, u, s, p');
                textEls.forEach(el => {
                    try {
                        // 跳过已处理容器
                        if (el.closest('.bjx-reveal, .bjx-link-reveal, .magnet-wrap, .bjx-modal, .bjx-enc')) return;
                        const cs = getComputedStyle(el);
                        const color = cs.color;
                        const bg = cs.backgroundColor;
                        const textLight = isLightColor(color);
                        const bgLight = isLightColor(bg);
                        const fs = parseFloat(cs.fontSize) || 0;
                        const hasHint = fontHasExplicitColor(el);

                        let needsReveal = false;
                        // 核心修复：捕获 <font color="#ffffff"> 白色文字容器（包含子a标签）
                        if (hasHint && textLight) needsReveal = true;
                        // 文字色等于背景色隐藏
                        else if (hasHint && bg !== 'rgba(0, 0, 0, 0)' && color === bg) needsReveal = true;
                        // 极小字号隐藏
                        else if (fs > 0 && fs < 8 && hasHint) needsReveal = true;

                        if (!needsReveal) return;

                        // 替换整个隐藏标签，保留内部所有内容（解决带链接font不显示问题）
                        const wrap = document.createElement('span');
                        wrap.className = 'bjx-reveal';
                        // 直接复制内部全部html，不会丢失a链接
                        wrap.innerHTML = el.innerHTML;
                        el.replaceWith(wrap);
                        styleSecret(wrap);

                        // 提取内部所有文本做资源匹配
                        const fullText = wrap.textContent.trim();
                        if (fullText && fullText.length <= 500) {
                            const item = createRevealedItem(fullText, wrap);
                            if (item) {
                                foundItems.push(item);
                                revealedItems.push(item);
                                saveHistory(item.magnet, extractBtih(item.magnet), 'magnet');
                                addedCount++;
                            }
                        }
                    } catch (e) {}
                });

                // 处理空白/图片隐藏链接
                const links = area.querySelectorAll('a');
                links.forEach(a => {
                    try {
                        if (a.classList.contains('bjx-has-link-reveal')) return;
                        if (a.closest('.bjx-reveal, .bjx-link-reveal, .magnet-wrap')) return;
                        if (!a.href || a.href === '#' || a.href.startsWith('javascript:') || a.href.startsWith('mailto:')) return;

                        const hasImg = a.querySelector('img');
                        const txt = a.textContent.trim();
                        const isSpaceOrTiny = txt.length === 0 || /^\s+$/.test(txt) || txt.length <= 3;

                        if (!hasImg && !isSpaceOrTiny) return;

                        const span = document.createElement('span');
                        span.className = 'bjx-link-reveal';
                        span.textContent = '🔗 ' + a.href;
                        a.append(document.createTextNode(' '), span);
                        a.classList.add('bjx-has-link-reveal');
                        styleSecret(span);

                        const item = createRevealedItem(a.href, span);
                        if (item) {
                            foundItems.push(item);
                            revealedItems.push(item);
                            addedCount++;
                        }
                    } catch (e) {}
                });
            } catch (e) {}
        });
        return addedCount;
    }

    // 页面加载执行
    window.addEventListener('load', () => {
        setTimeout(scanHiddenContent, 600);
    });

    // 监听动态加载楼层/回复自动重扫
    let scanTimer = null;
    const observer = new MutationObserver(() => {
        clearTimeout(scanTimer);
        scanTimer = setTimeout(scanHiddenContent, 800);
    });
    observer.observe(document.body, {childList:true, subtree:true});

})();