// ==UserScript==
// @name         福利吧隐藏内容揭示
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  自动识别并显示页面白色隐藏文字、同色文字、空白隐藏链接、极小字号隐藏内容，提取磁力链接与网址
// @author       You
// @match        https://www.wnflb2023.com/forum.php*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    // 全局变量
    const isEnabled = true;
    const isWnflb = true;
    const seenHashes = new Set();
    const foundItems = [];
    const revealedItems = [];

    // § 8 隐藏内容揭示（仅福利吧）
    function getGrayLevel(r, g, b) {
        return r * 0.299 + g * 0.587 + b * 0.114;
    }

    function isLightColor(colorStr) {
        if (!colorStr) return false;
        if (colorStr === 'white' || colorStr === '#fff' || colorStr === '#ffffff') return true;
        try {
            const rgbaMatch = colorStr.match(/rgba\((\d+),\s*(\d+),\s*(\d+),\s*([.\d]+)\)/i);
            if (rgbaMatch) {
                if (parseFloat(rgbaMatch[4]) <= 0.2) return true;
                return getGrayLevel(+rgbaMatch[1], +rgbaMatch[2], +rgbaMatch[3]) > 192;
            }
            const rgbMatch = colorStr.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);
            if (rgbMatch) return getGrayLevel(+rgbMatch[1], +rgbMatch[2], +rgbMatch[3]) > 192;

            const h6 = colorStr.match(/^#([a-fA-F0-9]{6})$/);
            if (h6) return getGrayLevel(
                parseInt(h6[1].slice(0, 2), 16),
                parseInt(h6[1].slice(2, 4), 16),
                parseInt(h6[1].slice(4, 6), 16)
            ) > 192;

            const h3 = colorStr.match(/^#([a-fA-F0-9]{3})$/);
            if (h3) {
                const r = parseInt(h3[1][0] + h3[1][0], 16);
                const g = parseInt(h3[1][1] + h3[1][1], 16);
                const b = parseInt(h3[1][2] + h3[1][2], 16);
                return getGrayLevel(r, g, b) > 192;
            }
        } catch (e) {}
        return false;
    }

    function fontHasExplicitColor(font) {
        if (font.getAttribute('color')) return true;
        const s = font.style;
        return !!(s && (s.color || s.backgroundColor || s.background));
    }

    // 提取btih哈希
    function extractBtih(magnetStr) {
        if (!magnetStr) return null;
        const match = magnetStr.match(/urn:btih:([0-9a-fA-F]{32,40})/);
        return match ? match[1].toLowerCase() : null;
    }

    // 保存历史（简易空实现，你后续可以拓展本地存储）
    function saveHistory(link, hash, type) {
        // 如需持久化磁力历史可以在这里写入localStorage
    }

    function createRevealedItem(text, element) {
        try {
            if (/^magnet:\?/i.test(text)) {
                return {
                    encoded: text,
                    magnet: text,
                    element,
                    type: 'magnet'
                };
            }
            const hashMatch = text.match(/^([a-fA-F0-9]{32,40})$/);
            if (hashMatch) {
                const btih = hashMatch[1].toLowerCase();
                if (seenHashes.has(btih)) {
                    for (const item of foundItems) {
                        if (item.type !== 'url' && extractBtih(item.magnet) === btih) {
                            item.element = element;
                            break;
                        }
                    }
                    return null;
                }
                seenHashes.add(btih);
                return {
                    encoded: text,
                    magnet: 'magnet:?xt=urn:btih:' + btih,
                    element,
                    type: 'magnet'
                };
            }
            if (/^https?:\/\//i.test(text)) {
                return {
                    encoded: text,
                    magnet: text,
                    element,
                    type: 'url'
                };
            }
            if (/^[a-zA-Z0-9][-a-zA-Z0-9]*\.[a-zA-Z]{2,}(\/|$)/.test(text)) {
                return {
                    encoded: text,
                    magnet: 'https://' + text,
                    element,
                    type: 'url'
                };
            }
        } catch (e) {}
        return null;
    }

    // 显示元素样式
    function styleSecret(el) {
        el.style.background = '#ff3333';
        el.style.color = '#ffffff';
        el.style.padding = '2px 4px';
        el.style.borderRadius = '3px';
        el.style.fontWeight = 'bold';
        el.style.display = 'inline-block';
        el.style.margin = '0 3px';
    }

    function scanHiddenContent() {
        if (!isEnabled || !document.body || !isWnflb) return 0;
        const postAreas = document.querySelectorAll('td.t_f, .message');
        let addedCount = 0;

        postAreas.forEach(area => {
            try {
                // 1) 隐藏文字：白字 / 同色字 / 极小字号
                const textEls = area.querySelectorAll('font, span, b, i, strong, em, u, s, p');
                textEls.forEach(el => {
                    try {
                        if (el.closest('.bjx-reveal, .bjx-link-reveal, .magnet-wrap, .bjx-modal, .bjx-enc, .bjx-dock-dropdown')) return;
                        if (el.children.length > 0) return; // 只处理叶子节点，避免重复包裹

                        const text = (el.textContent || '').trim();
                        if (!text || text.length > 200) return;

                        const cs = getComputedStyle(el);
                        const color = cs.color;
                        const bg = cs.backgroundColor;
                        const textLight = isLightColor(color);
                        const bgLight = isLightColor(bg);
                        const fs = parseFloat(cs.fontSize) || 0;
                        const hasHint = fontHasExplicitColor(el) || el.getAttribute('size') || (el.style && el.style.fontSize);

                        let needsReveal = false;
                        if (hasHint && textLight && bgLight) needsReveal = true;
                        else if (hasHint && bg !== 'rgba(0, 0, 0, 0)' && color && bg && color === bg) needsReveal = true;
                        else if (fs > 0 && fs < 8 && (el.getAttribute('size') || (el.style && el.style.fontSize))) needsReveal = true;

                        if (!needsReveal) return;

                        const wrap = document.createElement('span');
                        wrap.className = 'bjx-reveal';
                        wrap.textContent = text;
                        el.replaceWith(wrap);
                        styleSecret(wrap);

                        const item = createRevealedItem(text, wrap);
                        if (item) {
                            foundItems.push(item);
                            revealedItems.push(item);
                            saveHistory(item.magnet, extractBtih(item.magnet) || item.magnet, 'magnet');
                            addedCount++;
                        }
                    } catch (e) {}
                });

                // 2) 隐藏超链接：图片链接 / 空白文字链接
                const links = area.querySelectorAll('a');
                links.forEach(a => {
                    try {
                        if (a.classList.contains('bjx-has-link-reveal')) return;
                        if (a.closest('.bjx-reveal, .bjx-link-reveal, .magnet-wrap, .bjx-modal, .bjx-dock-dropdown')) return;
                        if (!a.href || a.href === '#' || a.href.startsWith('javascript:') || a.href.startsWith('mailto:')) return;

                        const hasImg = a.querySelector('img');
                        const txt = (a.textContent || '').trim();
                        const isSpaceOrTiny = txt.length === 0 || /^[\s ]+$/.test(txt) || txt.length <= 3;

                        if (!hasImg && !isSpaceOrTiny) return;

                        const span = document.createElement('span');
                        span.className = 'bjx-link-reveal';
                        span.textContent = '🔗 ' + a.href;
                        a.appendChild(document.createTextNode(' '));
                        a.appendChild(span);
                        a.classList.add('bjx-has-link-reveal');
                        styleSecret(span);

                        const item = createRevealedItem(a.href, span);
                        if (item) {
                            foundItems.push(item);
                            revealedItems.push(item);
                            addedCount++;
                        }
                    } catch (e) {}
                });
            } catch (e) {}
        });
        return addedCount;
    }

    // 页面加载完成执行
    window.addEventListener('load', () => {
        setTimeout(() => {
            scanHiddenContent();
            console.log('隐藏内容扫描完成');
        }, 600);
    });

    // 监听页面滚动、ajax加载新楼层（论坛翻页/加载回复）自动重新扫描
    let scanTimer = null;
    const observer = new MutationObserver(() => {
        clearTimeout(scanTimer);
        scanTimer = setTimeout(() => {
            scanHiddenContent();
        }, 800);
    });
    observer.observe(document.body, { childList: true, subtree: true });

})();